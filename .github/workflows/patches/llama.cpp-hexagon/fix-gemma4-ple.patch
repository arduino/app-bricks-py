From c4010e5568c52f36c5bb9a8e8df3b0929a463a2c Mon Sep 17 00:00:00 2001
From: Marco Colombo <ing.marco.colombo@gmail.com>
Date: Wed, 4 Nov 2026 14:05:50 +0100
Subject: [PATCH] gemma4: keep per-layer input embeddings contiguous for
 multi-device splits

---
 src/models/gemma4.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/models/gemma4.cpp b/src/models/gemma4.cpp
index 9c061310ded..9162860ee22 100644
--- a/src/models/gemma4.cpp
+++ b/src/models/gemma4.cpp
@@ -556,5 +556,6 @@ ggml_tensor * llama_model_gemma4::graph::project_per_layer_inputs(ggml_tensor *
     cb(inp_per_layer, "inp_per_layer", -1);
 
     // permute to shape: [n_embd_per_layer, n_tokens, n_layer]
-    return ggml_permute(ctx0, inp_per_layer, 0, 2, 1, 3);
+    // keep contiguous: with a layer split, a strided slice copied to another device also copies the rows of all other layers
+    return ggml_cont(ctx0, ggml_permute(ctx0, inp_per_layer, 0, 2, 1, 3));
 }
