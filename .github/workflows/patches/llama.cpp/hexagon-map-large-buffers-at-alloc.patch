From 4d6c544927cd14872c174ce4334b2004099def93 Mon Sep 17 00:00:00 2001
From: Marco Colombo <ing.marco.colombo@gmail.com>
Date: Thu, 26 Nov 2026 08:37:41 +0100
Subject: [PATCH] hexagon: map buffer early to properly release resources on
 fail

---
 ggml/src/ggml-hexagon/ggml-hexagon.cpp | 10 ++++++++--
 tools/mtmd/mtmd-model.cpp              |  3 +++
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-hexagon/ggml-hexagon.cpp b/ggml/src/ggml-hexagon/ggml-hexagon.cpp
index ccb128e06..5e2b36c16 100644
--- a/ggml/src/ggml-hexagon/ggml-hexagon.cpp
+++ b/ggml/src/ggml-hexagon/ggml-hexagon.cpp
@@ -70,6 +70,7 @@ using uintvec = std::vector<unsigned int>;
 using u32vec  = std::vector<uint32_t>;
 
 #define GGML_HEXAGON_MAX_SESSIONS          16
+#define GGML_HEXAGON_EARLY_MAP_SIZE        ((size_t) 128 << 20) // buffers this large are mapped at allocation
 
 struct ggml_hexagon_device_config {
     int         physical_idx = 0;
@@ -960,8 +961,13 @@ static ggml_backend_buffer_t ggml_backend_hexagon_buffer_type_alloc_buffer(
         return nullptr;
     }
     try {
-        ggml_hexagon_shared_buffer * sbuf = new ggml_hexagon_shared_buffer(sess, size, false);
-        return ggml_backend_buffer_init(buffer_type, ggml_backend_hexagon_buffer_interface, sbuf, size);
+        auto sbuf = std::make_unique<ggml_hexagon_shared_buffer>(sess, size, false);
+        // map large buffers now: a mapping failure is then an allocation failure, not an abort at compute time
+        // (dma64 picks the mapping type at first use)
+        if (!opt_dma64 && size >= GGML_HEXAGON_EARLY_MAP_SIZE) {
+            sbuf->mmap();
+        }
+        return ggml_backend_buffer_init(buffer_type, ggml_backend_hexagon_buffer_interface, sbuf.release(), size);
     } catch (const std::exception & exc) {
         GGML_LOG_ERROR("ggml-hex: %s failed to allocate device buffer context: %s\n", dev_ctx->c_name(), exc.what());
         return nullptr;
diff --git a/tools/mtmd/mtmd-model.cpp b/tools/mtmd/mtmd-model.cpp
index 508dfbe94..380672d27 100644
--- a/tools/mtmd/mtmd-model.cpp
+++ b/tools/mtmd/mtmd-model.cpp
@@ -4442,6 +4442,9 @@ struct mtmd_model_loader {
 
             // alloc memory and offload data
             model.buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(model.ctx_data.get(), buft));
+            if (!model.buf) {
+                throw std::runtime_error(mtmd_format("%s: unable to allocate %s buffer\n", __func__, ggml_backend_buft_name(buft)));
+            }
             ggml_backend_buffer_set_usage(model.buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
             // read the weight from file
             if (!no_alloc) {
-- 
2.34.1

