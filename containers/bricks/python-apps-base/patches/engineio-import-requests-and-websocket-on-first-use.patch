From 327ae3a061d9970ee92070e24388c4787d4458f9 Mon Sep 17 00:00:00 2001
From: Marco Colombo <ing.marco.colombo@gmail.com>
Date: Wed, 14 Oct 2026 17:33:16 +0200
Subject: [PATCH] Import requests and websocket-client on first use

Importing engineio imported requests and websocket-client at module level,
through engineio.client, even for programs that only run a server: Socket.IO
servers import socketio, which imports socketio.client, which imports engineio.
On a small ARM board that is ~250 ms of start time (requests ~220 ms, with
urllib3 and charset_normalizer, websocket-client ~25 ms) spent on a client
that is never instantiated.

Both are now imported where they are used, by the methods of the transport
that needs them, and the connect methods check that the package is installed
with importlib.util.find_spec, reporting a missing one as before.

Made against python-engineio 4.14.0, the version in uv.lock, for the
python-apps-base image of arduino/app-bricks-py; to be proposed upstream to
miguelgrinberg/python-engineio.
---
 engineio/client.py | 17 +++++++----------
 1 file changed, 7 insertions(+), 10 deletions(-)

diff --git a/engineio/client.py b/engineio/client.py
index a83a4c0..e3b0f5d 100644
--- a/engineio/client.py
+++ b/engineio/client.py
@@ -1,5 +1,6 @@
 from base64 import b64encode
 from http.cookies import SimpleCookie
+import importlib.util
 import logging
 import queue
 import ssl
@@ -8,14 +9,6 @@ import time
 import urllib
 from engineio.json import JSONDecodeError
 
-try:
-    import requests
-except ImportError:  # pragma: no cover
-    requests = None
-try:
-    import websocket
-except ImportError:  # pragma: no cover
-    websocket = None
 from . import base_client
 from . import exceptions
 from . import packet
@@ -186,7 +179,7 @@ class Client(base_client.BaseClient):
 
     def _connect_polling(self, url, headers, engineio_path):
         """Establish a long-polling connection to the Engine.IO server."""
-        if requests is None:  # pragma: no cover
+        if importlib.util.find_spec('requests') is None:  # pragma: no cover
             # not installed
             self.logger.error('requests package is not installed -- cannot '
                               'send HTTP requests!')
@@ -253,11 +246,12 @@ class Client(base_client.BaseClient):
 
     def _connect_websocket(self, url, headers, engineio_path):
         """Establish or upgrade to a WebSocket connection with the server."""
-        if websocket is None:  # pragma: no cover
+        if importlib.util.find_spec('websocket') is None:  # pragma: no cover
             # not installed
             self.logger.error('websocket-client package not installed, only '
                               'polling transport is available')
             return False
+        import websocket
         websocket_url = self._get_engineio_url(url, engineio_path, 'websocket')
         if self.sid:
             self.logger.info(
@@ -457,6 +451,7 @@ class Client(base_client.BaseClient):
     def _send_request(
             self, method, url, headers=None, body=None,
             timeout=None):  # pragma: no cover
+        import requests
         if self.http is None:
             self.http = requests.Session()
         if not self.ssl_verify:
@@ -543,6 +538,7 @@ class Client(base_client.BaseClient):
 
     def _read_loop_websocket(self):
         """Read packets from the Engine.IO WebSocket connection."""
+        import websocket
         while self.state == 'connected' and self.write_loop_task:
             p = None
             try:
@@ -647,6 +643,7 @@ class Client(base_client.BaseClient):
                     break
             else:
                 # websocket
+                import websocket
                 try:
                     for pkt in packets:
                         encoded_packet = pkt.encode()
