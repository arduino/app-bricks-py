#!/bin/sh

# SPDX-FileCopyrightText: Copyright (C) Arduino s.r.l. and/or its affiliated companies
#
# SPDX-License-Identifier: MPL-2.0

# Usage: licensed-gem <licensed version> <licensee version>
# Installs the licensed gem with a pinned licensee, so classification does not drift, and drops the rugged build leftovers

set -e

gem install licensee -v "$2"
gem install licensed -v "$1"
rm -rf /var/lib/gems/*/cache \
       /var/lib/gems/*/gems/rugged-*/vendor \
       /var/lib/gems/*/gems/rugged-*/ext
